# Copy to Track_Signal_Dose/.env (one level ABOVE the repo) and fill in. Never commit .env.

# --- local model (the scored run is offline; these are local settings, not keys)
OLLAMA_URL=http://127.0.0.1:11434
SIGNALVAULT_MODEL=qwen3.5:4b
# Optional override if the packet is not at ../SignalDose_Packet
# SIGNALVAULT_PACKET=C:/path/to/SignalDose_Packet

# --- dev-time only (NEVER used by the scored/offline path; public data only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Surge "Public Evidence Radar" (stretch, online, public sources only)
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
